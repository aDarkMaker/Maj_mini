{
	"name": "bun-react-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/index.tsx",
		"build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
		"start": "NODE_ENV=production bun src/index.tsx",
		"build:engine": "cd backend && zig build -Doptimize=ReleaseFast",
		"test:engine": "cd backend && zig build test",
		"game": "bun run src/server.ts",
		"demo": "bun run src/test/demo.ts",
		"train:data": "bun run src/ai/run_dataset_gen.ts",
		"train:data:repro": "bun run src/ai/run_dataset_gen.ts 100 10 42",
		"test": "bun test src/test/",
		"typecheck": "bunx tsc --noEmit",
		"docs:dev": "vitepress dev wiki",
		"docs:build": "vitepress build wiki",
		"docs:preview": "vitepress preview wiki"
	},
	"dependencies": {
		"@types/lodash": "^4.17.24",
		"cspell": "^9.7.0",
		"immer": "^11.1.4",
		"lodash": "^4.17.23",
		"prettier": "^3.8.1",
		"react": "^19",
		"react-dom": "^19"
	},
	"devDependencies": {
		"@mermaid-js/mermaid-cli": "^11.16.0",
		"@types/bun": "latest",
		"@types/node": "^26.2.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"vitepress": "^1.6.4"
	}
}
